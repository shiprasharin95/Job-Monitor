        <mxCell id="jobSched" value="&lt;b&gt;SAP Job Scheduling&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Daily warning trigger&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#FFFFFF;fontColor=#1D2D3E;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1130" y="450" width="160" height="70" as="geometry"/></mxCell>
        <mxCell id="alert" value="&lt;b&gt;Alert Notification Service&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Warning delivery and escalation&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#FFFFFF;fontColor=#1D2D3E;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="470" width="180" height="65" as="geometry"/></mxCell>
        <mxCell id="net" value="&lt;b&gt;NETWORK&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontColor=#475E75;fontFamily=Helvetica;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1690" y="118" width="160" height="20" as="geometry"/></mxCell>
        <mxCell id="network" value="" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#475E75;fillColor=#FFFFFF;arcSize=24;absoluteArcSize=1;strokeWidth=1.5;dashed=1;dashPattern=8 8;" vertex="1" parent="1"><mxGeometry x="1680" y="150" width="260" height="530" as="geometry"/></mxCell>
        <mxCell id="calm" value="&lt;b&gt;SAP Cloud ALM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Jobs and Automation Monitoring&lt;br&gt;Analytics OData API / Jobs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#0070F2;fillColor=#FFFFFF;fontColor=#1D2D3E;fontFamily=Helvetica;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="185" width="220" height="125" as="geometry"/></mxCell>
        <mxCell id="raw" value="&lt;b&gt;Optional Raw Data Outbound Logs&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;jam.run and jam.run_step&lt;br&gt;Individual execution enrichment&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#470BED;fillColor=#F1EDFF;fontColor=#1D2D3E;fontFamily=Helvetica;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1700" y="350" width="220" height="105" as="geometry"/></mxCell>
        <mxCell id="note" value="&lt;b&gt;Target architecture&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Cloud ALM Jobs analytics supplies aggregated failure metrics. Raw outbound logs are required for individual execution details and error payloads.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E76500;fillColor=#FFF8E5;fontColor=#1D2D3E;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="560" y="635" width="750" height="72" as="geometry"/></mxCell>
        <mxCell id="f1" value="Flow 1 - Joule path: User asks Joule for a batch-job failure summary. Joule authenticates the user, invokes the CAP agent, which reads Cloud ALM job metrics through the BTP destination and optionally uses Generative AI Hub to summarize risk and next actions." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#E76500;fillColor=#FFF8E5;fontColor=#1D2D3E;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="210" y="820" width="700" height="170" as="geometry"/></mxCell>
        <mxCell id="f2" value="Flow 2 - Scheduled warning: SAP Job Scheduling calls the CAP scheduled endpoint. The agent evaluates aborted and application-error metrics from Cloud ALM, persists warning state as needed, optionally requests an AI summary, and sends an escalation through Alert Notification Service." style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#07838F;fillColor=#DAFDF5;fontColor=#1D2D3E;fontFamily=Helvetica;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="940" y="820" width="700" height="170" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#E76500;endArrow=blockThin;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="user" target="joule"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#188918;endArrow=blockThin;endFill=1;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="joule" target="identity"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#E76500;endArrow=blockThin;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="joule" target="cap"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#07838F;endArrow=blockThin;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="cap" target="aihub"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0070F2;endArrow=blockThin;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="cap" target="dest"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#0070F2;endArrow=blockThin;endFill=1;strokeWidth=1.5;" edge="1" parent="1" source="dest" target="calm"><mxGeometry relative="1" as="geometry"/></mxCell>
