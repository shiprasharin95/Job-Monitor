        <mxCell id="title" value="&lt;font color=&quot;#0070f2&quot; face=&quot;arial&quot; style=&quot;font-size: 20px;&quot;&gt;&lt;b&gt;Job Failure Warning (Batch Jobs) Agent on SAP BTP&lt;/b&gt;&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="40" y="26" width="700" height="30" as="geometry"/></mxCell>
