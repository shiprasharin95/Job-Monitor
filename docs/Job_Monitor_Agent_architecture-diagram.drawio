<mxfile host="app.diagrams.net">
  <diagram id="jobmon2" name="Job Monitor Agent on SAP BTP (IDoc style)">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1040" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="&lt;b&gt;&lt;font style=&quot;font-size:22px&quot; color=&quot;#0a6ed1&quot;&gt;Job Monitor Agent on SAP BTP&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;An agent and dashboard that monitor SAP Cloud ALM job runs. Users ask Joule about failed jobs or open the dashboard;&lt;br&gt;a scheduled sync keeps the data current from SAP Cloud ALM and warns job schedulers by e-mail. Sign-in is single sign-on (SSO) through SAP Cloud Identity Services.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="30" y="10" width="900" height="70" as="geometry"/>
        </mxCell>

        <!-- Application clients -->
        <mxCell id="user" value="User" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;fillColor=#eaf3fc;strokeColor=#0a6ed1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="47" y="250" width="30" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="clients" value="&lt;b&gt;Application Clients&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#5b738b&quot;&gt;Browser / Joule app&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f6f7;strokeColor=#89919a;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="20" y="400" width="120" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="e_u" style="endArrow=none;dashed=1;strokeColor=#89919a;" edge="1" parent="1" source="user" target="clients"><mxGeometry relative="1" as="geometry"/></mxCell>

        <!-- BTP -->
        <mxCell id="btp" value="" style="rounded=1;arcSize=2;fillColor=#f4f9fe;strokeColor=#0a6ed1;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="170" y="110" width="1090" height="620" as="geometry"/>
        </mxCell>
        <mxCell id="btp_lbl" value="&lt;b&gt;SAP BTP&lt;/b&gt;" style="rounded=1;fillColor=#0a6ed1;strokeColor=none;fontColor=#ffffff;html=1;" vertex="1" parent="1">
          <mxGeometry x="182" y="118" width="100" height="24" as="geometry"/>
        </mxCell>

        <!-- Subaccount A -->
        <mxCell id="subA" value="&lt;b&gt;Subaccount A&lt;/b&gt;" style="rounded=1;arcSize=2;html=1;verticalAlign=top;align=left;spacingLeft=10;fillColor=#ffffff;strokeColor=#0a6ed1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="190" y="160" width="250" height="540" as="geometry"/>
