        <mxCell id="pOData" value="OData + JWT" style="rounded=1;arcSize=50;html=1;fillColor=#eaf3fc;strokeColor=#0a6ed1;fontColor=#0a6ed1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="730" y="297" width="62" height="16" as="geometry"/></mxCell>
        <mxCell id="pUps" value="Upsert" style="rounded=1;arcSize=50;html=1;fillColor=#f0fbf6;strokeColor=#1a9d6c;fontColor=#1a9d6c;fontSize=8;" vertex="1" parent="1"><mxGeometry x="554" y="582" width="42" height="16" as="geometry"/></mxCell>
        <mxCell id="pRead" value="Read" style="rounded=1;arcSize=50;html=1;fillColor=#eaf3fc;strokeColor=#0a6ed1;fontColor=#0a6ed1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="654" y="587" width="36" height="16" as="geometry"/></mxCell>
        <mxCell id="pAuth" value="Authorization" style="rounded=1;arcSize=50;html=1;fillColor=#f9eefc;strokeColor=#c026d3;fontColor=#c026d3;fontSize=8;" vertex="1" parent="1"><mxGeometry x="860" y="587" width="70" height="16" as="geometry"/></mxCell>
        <mxCell id="pOAuth" value="OAuth2" style="rounded=1;arcSize=50;html=1;fillColor=#eaf3fc;strokeColor=#0a6ed1;fontColor=#0a6ed1;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1243" y="209" width="46" height="16" as="geometry"/></mxCell>
        <mxCell id="pAI" value="AI call" style="rounded=1;arcSize=50;html=1;fillColor=#fff4e5;strokeColor=#e9730c;fontColor=#e9730c;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1257" y="322" width="36" height="16" as="geometry"/></mxCell>
        <mxCell id="pRun" value="/run" style="rounded=1;arcSize=50;html=1;fillColor=#f0fbf6;strokeColor=#1a9d6c;fontColor=#1a9d6c;fontSize=8;" vertex="1" parent="1"><mxGeometry x="960" y="452" width="34" height="16" as="geometry"/></mxCell>
        <mxCell id="pMail" value="Graph" style="rounded=1;arcSize=50;html=1;fillColor=#f5f6f7;strokeColor=#5b738b;fontColor=#5b738b;fontSize=8;" vertex="1" parent="1"><mxGeometry x="1233" y="470" width="44" height="16" as="geometry"/></mxCell>

        <!-- Step badges: 1-4 and 6 user flow (blue), A-D sync flow (green). Step 5 is the answer back to the user -->
        <mxCell id="b1" value="1" style="ellipse;html=1;fillColor=#0a6ed1;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="149" y="290" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="b2" value="2" style="ellipse;html=1;fillColor=#0a6ed1;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="444" y="540" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="b3" value="3" style="ellipse;html=1;fillColor=#0a6ed1;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="434" y="312" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="b4" value="4" style="ellipse;html=1;fillColor=#0a6ed1;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="629" y="584" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="b6" value="6" style="ellipse;html=1;fillColor=#0a6ed1;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="400" y="84" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="bA" value="A" style="ellipse;html=1;fillColor=#1a9d6c;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1251" y="226" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="bB" value="B" style="ellipse;html=1;fillColor=#1a9d6c;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="529" y="579" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="bC" value="C" style="ellipse;html=1;fillColor=#1a9d6c;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="966" y="474" width="22" height="22" as="geometry"/></mxCell>
        <mxCell id="bD" value="D" style="ellipse;html=1;fillColor=#1a9d6c;strokeColor=#ffffff;fontColor=#ffffff;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1244" y="430" width="22" height="22" as="geometry"/></mxCell>

        <!-- Flow boxes -->
        <mxCell id="flow1" value="&lt;b&gt;&lt;font color=&quot;#e9730c&quot; style=&quot;font-size:13px&quot;&gt;Flow 1 - User path (SSO, Joule and dashboard)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b738b&quot;&gt;Single sign-on, A2A, user token, read-only&lt;/font&gt;&lt;br&gt;&lt;br&gt;1. The user signs in with single sign-on (SAML/OIDC via SAP Cloud Identity Services) and asks Joule, e.g. &quot;How many jobs have failed today?&quot;&lt;br&gt;2. SAP Cloud Identity Services issues the user token (trust between Joule and the identity provider).&lt;br&gt;3. Joule calls the Job Monitor agent over A2A with the user token.&lt;br&gt;4. The agent validates the token in Authorization and Trust Management, checks the role and reads the job data from SAP HANA Cloud.&lt;br&gt;5. Joule shows a summary, the latest failed jobs and a link to the dashboard.&lt;br&gt;6. Alternatively the user opens the dashboard with single sign-on and sees KPIs, failed jobs and AI analysis." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=11;fillColor=#fff4e5;strokeColor=#e9730c;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="30" y="760" width="620" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="flow2" value="&lt;b&gt;&lt;font color=&quot;#0a6ed1&quot; style=&quot;font-size:13px&quot;&gt;Flow 2 - Scheduled sync&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#5b738b&quot;&gt;Technical, no user&lt;/font&gt;&lt;br&gt;&lt;br&gt;A. Every 60 s the sync reads job runs and logs from SAP Cloud ALM via the CLOUD_ALM_API destination.&lt;br&gt;B. Runs and events are upserted into SAP HANA Cloud in one transaction.&lt;br&gt;C. SAP Job Scheduling can also trigger POST /run (scope JobRunner).&lt;br&gt;D. Failures trigger one grouped e-mail per scheduler via Microsoft Graph." style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=11;fillColor=#eaf3fc;strokeColor=#0a6ed1;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="670" y="760" width="620" height="250" as="geometry"/>
        </mxCell>

        <!-- Legend -->
        <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0a6ed1&quot;&gt;&lt;b&gt;1-6&lt;/b&gt;&lt;/font&gt; User flow steps (Flow 1)&lt;br&gt;&lt;font color=&quot;#1a9d6c&quot;&gt;&lt;b&gt;A-D&lt;/b&gt;&lt;/font&gt; Sync flow steps (Flow 2)&lt;br&gt;&lt;font color=&quot;#e9730c&quot;&gt;&amp;#9473;&amp;#9473;&lt;/font&gt; Joule / A2A / user token&lt;br&gt;&lt;font color=&quot;#0a6ed1&quot;&gt;&amp;#9473;&amp;#9473;&lt;/font&gt; Data read / user HTTPS&lt;br&gt;&lt;font color=&quot;#1a9d6c&quot;&gt;&amp;#9473;&amp;#9473;&lt;/font&gt; SSO / federation / scheduled sync&lt;br&gt;&lt;font color=&quot;#c026d3&quot;&gt;- - -&lt;/font&gt; Trust / authorization (dashed)&lt;br&gt;&lt;font color=&quot;#5b738b&quot;&gt;&amp;#9473;&amp;#9473;&lt;/font&gt; Technical credentials" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=14;spacingTop=8;fontSize=11;fillColor=#f5f6f7;strokeColor=#89919a;" vertex="1" parent="1">
          <mxGeometry x="1310" y="760" width="260" height="250" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
